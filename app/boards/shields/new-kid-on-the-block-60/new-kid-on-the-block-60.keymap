
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      // ---------------------------------------------------------------------------------------
      // | DEL |  1  |  2  |  3  |  4  |  5  |             |  6  |  7  |  8  |  9  |  0  |
      // | TAB |  Q  |  W  |  E  |  R  |  T  |             |  Y  |  U  |  I  |  O  |  P  | BSPC|
      // | ESC |  A  |  S  |  D  |  F  |  G  |             |  H  |  J  |  K  |  L  |  ;  | RET |
      // | SHFT|  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  | SHFT|
      //       | CTRL| ALT | GUI | ESC | SPC | RET | | TAB | SHFT| ESC | LEFT| DOWN| UP  |RIGHT|
      // ---------------------------------------------------------------------------------------

      bindings = <
        &kp DEL     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                              &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp BSPC
        &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T                               &kp Y       &kp U       &kp I       &kp O       &kp P       &kp RET
        &kp ESC     &kp A       &kp S       &kp D       &kp F       &kp G                               &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp RSHFT
        &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B                               &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RIGHT
                    &kp LCTRL   &kp LALT    &kp LGUI    &kp ESC     &kp SPACE   &kp RET      &kp TAB    &kp LSHIFT  &kp ESC     &kp LEFT    &kp DOWN    &kp UP
      >;
    };
  };
};
